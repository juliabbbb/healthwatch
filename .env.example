# AI-assisted analysis (server-side only; never commit your real key)
# Get a free key at https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=
# Optional: primary model + fallback chain tried in order when a model's
# free-tier quota is exhausted. Free-tier limits are per model.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Alternative provider (used only if GEMINI_API_KEY is not set)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

DATABASE_URL=